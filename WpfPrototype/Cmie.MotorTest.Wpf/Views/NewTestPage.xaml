<UserControl x:Class="Cmie.MotorTest.Wpf.Views.NewTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRootStyle}"
             Loaded="NewTestPage_Loaded">
    <Grid Background="{DynamicResource PageBrush}" ClipToBounds="True">
        <!-- 低对比工程网格：只参与视觉，不拦截表单操作 -->
        <Rectangle IsHitTestVisible="False" Opacity="0.72">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H36 V36 H0 Z"/>
                            <GeometryDrawing Geometry="M36,0 L0,0 0,36">
                                <GeometryDrawing.Pen><Pen Brush="#120284C7" Thickness="0.7"/></GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <RadialGradientBrush Center="0.5,0.44" RadiusX="0.74" RadiusY="0.72">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#55000000" Offset="0.52"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- 青蓝环境光与电机测试线框装饰 -->
        <Canvas IsHitTestVisible="False" Opacity="0.9">
            <Ellipse Canvas.Left="-240" Canvas.Top="-190" Width="650" Height="650">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2406B6D4" Offset="0"/>
                        <GradientStop Color="#0C0284C7" Offset="0.52"/>
                        <GradientStop Color="#000284C7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Right="-260" Canvas.Bottom="-230" Width="720" Height="720">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#200284C7" Offset="0"/>
                        <GradientStop Color="#0806B6D4" Offset="0.58"/>
                        <GradientStop Color="#0006B6D4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Canvas.Right="54" Canvas.Top="64" Width="210" Height="210" Opacity="0.38">
                <Ellipse Stroke="#660284C7" StrokeThickness="1"/>
                <Ellipse Width="158" Height="158" Stroke="#5506B6D4" StrokeThickness="1"/>
                <Ellipse Width="104" Height="104" Stroke="#660284C7" StrokeThickness="1.2"/>
                <Ellipse Width="42" Height="42" Stroke="#8806B6D4" StrokeThickness="1.5"/>
                <Path Stroke="#550284C7" StrokeThickness="1" Data="M105,0 V210 M0,105 H210 M31,31 L179,179 M179,31 L31,179"/>
                <Ellipse Width="8" Height="8" Fill="#FF06B6D4"/>
            </Grid>

            <Path Canvas.Left="45" Canvas.Bottom="90" Width="270" Height="76"
                  Stroke="#6606B6D4" StrokeThickness="1.5" Stretch="Fill"
                  Data="M0,40 C18,40 19,13 37,13 C55,13 56,65 74,65 C92,65 93,20 111,20 C129,20 130,54 148,54 C166,54 167,8 185,8 C203,8 204,62 222,62 C240,62 247,38 270,38"/>
            <StackPanel Canvas.Left="46" Canvas.Bottom="46">
                <TextBlock Text="MOTOR TEST / NEW PROJECT" Foreground="#660284C7" FontSize="10" FontWeight="SemiBold"/>
                <Border Width="84" Height="2" CornerRadius="1" Background="#6606B6D4" HorizontalAlignment="Left" Margin="0,7,0,0"/>
            </StackPanel>
        </Canvas>

        <ScrollViewer Panel.ZIndex="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="8,8,8,24">
        <Border Style="{StaticResource PanelStyle}"
                Width="760"
                MaxWidth="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="32,28,32,24"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#2A0F172A" BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="试验操作 / 新建试验"
                           FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="新建试验"
                           Style="{StaticResource HeadingTextStyle}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <Border Width="36"
                        Height="3"
                        CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,8"/>
                <TextBlock Text="填写电机与试验基础参数后进入试验项目（演示数据，不写入真实设备）。"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>

                <UniformGrid Columns="2" Rows="8">
                    <!-- 电机编号 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="＃" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="电机编号" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="MotorIdBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 电机型号 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="◎" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="电机型号" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="ModelBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 生产厂家 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="厂" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="生产厂家" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="MakerBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 出厂编号 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="№" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="出厂编号" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="FactoryNoBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 额定电压 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="V" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="额定电压" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="V" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="VoltageBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 额定电流 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="A" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="额定电流" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="A" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="CurrentBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 额定功率 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="P" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="额定功率" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="kW" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="PowerBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 额定频率 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="f" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="额定频率" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Hz" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="FreqBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 额定转速 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="n" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="额定转速" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="rpm" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="SpeedBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 功率因数 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="φ" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="功率因数" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="PfBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 接法 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="Y" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="接法" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="ConnBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 绝缘等级 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="绝" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="绝缘等级" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="InsulBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 运行工作制 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="制" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="运行工作制" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="DutyBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 防护等级 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="IP" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="防护等级" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="IpBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 电机极数 -->
                    <Grid Margin="0,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="极" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="电机极数" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="P" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                                <TextBox x:Name="PolesBox" Style="{StaticResource FormTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 冷却方式 -->
                    <Grid Margin="14,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FormFieldIconStyle}">
                            <TextBlock Text="冷" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="冷却方式" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="14"/>
                        <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                            <TextBox x:Name="CoolBox" Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>
                    </Grid>
                </UniformGrid>

                <!-- 样品名称 full width -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FormFieldIconStyle}">
                        <TextBlock Text="样" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="样品名称" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="14"/>
                    <Border Grid.Column="2" Style="{StaticResource FormInputChromeStyle}" Margin="10,0,0,0">
                        <TextBox x:Name="SampleBox" Style="{StaticResource FormTextBoxStyle}"/>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Content="取消"
                            MinWidth="96"
                            Click="Cancel_Click"/>
                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                            Content="进入试验"
                            MinWidth="112"
                            Margin="10,0,0,0"
                            Click="Enter_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
