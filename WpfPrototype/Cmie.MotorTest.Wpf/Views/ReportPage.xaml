<UserControl x:Class="Cmie.MotorTest.Wpf.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRootStyle}">
    <UserControl.Resources>
        <!-- 使用应用级动态主题颜色，避免局部浅色资源覆盖夜间主题。 -->
        <DropShadowEffect x:Key="PrecisionCardShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.07"/>

        <Style x:Key="ReportBoardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Effect" Value="{StaticResource PrecisionCardShadow}"/>
        </Style>
        <Style x:Key="ReportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="82"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ReportPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        </Style>
        <Style x:Key="ReportToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportButtonStyle}">
            <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="72"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ReportCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource PanelBrush}"><Path x:Name="Tick" Data="M3,8 L7,12 L14,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineSoftBrush}"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource MetricBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="{DynamicResource MetricBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border x:Name="Cell" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,10">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="工作区 / 报表输出" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="报表输出" Margin="0,5,0,0" Style="{StaticResource HeadingTextStyle}" FontSize="24"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="56,0,0,0" Width="980" Height="568" HorizontalAlignment="Left" VerticalAlignment="Top"
                Style="{StaticResource ReportBoardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Height="2" VerticalAlignment="Top" Panel.ZIndex="2">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#007A87" Offset="0"/><GradientStop Color="#33007A87" Offset="0.72"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="报表章节" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="16,10" VerticalAlignment="Center">
                            <Button Content="全选" Style="{StaticResource ReportToolButtonStyle}" Click="SelectAll_Click"/>
                            <Button Content="全不选" Margin="8,0,0,0" Style="{StaticResource ReportToolButtonStyle}" Click="SelectNone_Click"/>
                            <TextBlock Text="勾选需要写入报告的章节" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" x:Name="ReportGrid" ItemsSource="{Binding Reports}" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                                  CanUserAddRows="False" IsReadOnly="False" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="选项" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="选择" Width="68">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Style="{StaticResource ReportCheckBoxStyle}" Checked="ReportCheck_Changed" Unchecked="ReportCheck_Changed"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource MetricBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
                            <StackPanel Margin="18,14,18,0">
                                <TextBlock Text="导出顺序" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="按勾选顺序写入 Excel" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0">
                                <Grid>
                                    <TextBlock x:Name="EmptySelectionText" Text="尚未勾选章节" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,8"/>
                                    <ItemsControl ItemsSource="{Binding SelectedReports}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Index}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                                <StackPanel>
                                    <Button Height="40" Style="{StaticResource ReportPrimaryButtonStyle}" Click="Export_Click"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8 M12,11 L12,18 M9,15 L12,18 L15,15"/><TextBlock Text="报告输出"/></StackPanel></Button>
                                    <Button Height="40" Margin="0,8,0,0" Style="{StaticResource ReportButtonStyle}" Click="CloseExcel_Click"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8 M9,11 L15,17 M15,11 L9,17"/><TextBlock Text="关闭 Excel"/></StackPanel></Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
