<UserControl x:Class="Cmie.MotorTest.Wpf.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRootStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="200"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="26,22" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource GoodBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeroStatusText"
                                       Text="测试系统已就绪 · 项目 2025DJXXXX · 3/21 试验"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       LineHeight="18"
                                       Padding="0,2,0,2"
                                       VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Ideal"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroGreetingText"
                                   Style="{StaticResource HeadingTextStyle}"
                                   Text="早上好，超级用户"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   LineHeight="36"
                                   Padding="0,2,0,2"
                                   TextOptions.TextFormattingMode="Ideal"/>
                        <TextBlock Text="三相异步电机综合性能试验台"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   Padding="0,1,0,1"
                                   TextOptions.TextFormattingMode="Ideal"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                    Content="＋  新建试验"
                                    Click="NewTest_Click"/>
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="▶  继续当前试验"
                                    Click="ContinueTest_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Viewbox Grid.Column="1" Margin="25,20">
                        <Canvas Width="320" Height="130" Opacity="0.62">
                            <Ellipse Canvas.Left="38" Canvas.Top="24" Width="82" Height="82"
                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="49" Canvas.Top="35" Width="60" Height="60"
                                     Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="69" Canvas.Top="55" Width="20" Height="20"
                                     Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"/>
                            <Rectangle Canvas.Left="107" Canvas.Top="44" Width="94" Height="42"
                                       Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"/>
                            <Line X1="201" Y1="65" X2="235" Y2="65"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                            <Path Canvas.Left="152" Canvas.Top="12"
                                  Data="M0,28 C18,0 35,56 53,28 C71,0 88,56 106,28"
                                  Stroke="{DynamicResource AccentBrightBrush}"
                                  StrokeThickness="1.7"
                                  Fill="Transparent"/>
                            <Path Canvas.Left="152" Canvas.Top="42"
                                  Data="M0,28 C18,0 35,56 53,28 C71,0 88,56 106,28"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.5"
                                  Opacity="0.55"
                                  Fill="Transparent"/>
                            <Path Canvas.Left="152" Canvas.Top="70"
                                  Data="M0,28 C18,0 35,56 53,28 C71,0 88,56 106,28"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.5"
                                  Opacity="0.35"
                                  Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="2"
                                Margin="0,24,24,24"
                                VerticalAlignment="Center">
                        <TextBlock Text="快速操作"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,8"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Content="▣  打开试验项目"
                                Click="OpenProject_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Margin="0,7,0,0"
                                Content="⌁  查看实时数据"
                                Click="OpenRealtime_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Margin="0,7,0,0"
                                Content="▤  生成试验报告"
                                Click="OpenReport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="5">
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="平均电压" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="MetricVoltageValue"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="380.0 V"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="MetricVoltageHint"
                                   Text="三相平衡"
                                   Foreground="{DynamicResource GoodBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Margin="7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="平均电流" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="MetricCurrentValue"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="12.45 A"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="额定值 15.0 A" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Margin="7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="轴功率" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="MetricPowerValue"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="7150 W"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="MetricPowerHint"
                                   Text="效率 89.6%"
                                   Foreground="{DynamicResource GoodBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Margin="7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="转速" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="MetricSpeedValue"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="1486 rpm"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="稳定运行" Foreground="{DynamicResource GoodBrush}" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Margin="7,0,0,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="功率因数" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="MetricPfValue"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="0.86"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="目标 ≥ 0.85" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="试验进度" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProgressCountText"
                                       Text="3 / 21 项"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="✓" Foreground="{DynamicResource GoodBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="绝缘电阻" Margin="0,9,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="已完成" Foreground="{DynamicResource GoodBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="✓" Foreground="{DynamicResource GoodBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="直流电阻" Margin="0,9,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="已完成" Foreground="{DynamicResource GoodBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="3" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="空载试验" Margin="0,9,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="准备执行" Foreground="{DynamicResource AccentBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="设备状态" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1" Text="PLC 控制器"/>
                                <TextBlock Grid.Column="2" Text="已连接" Foreground="{DynamicResource GoodBrush}" FontSize="11"/>
                            </Grid>
                            <Separator Background="{DynamicResource LineSoftBrush}"/>
                            <Grid Margin="0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BadBrush}" Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1" Text="WT3K 功率分析仪"/>
                                <TextBlock Grid.Column="2" Text="连接失败" Foreground="{DynamicResource BadBrush}" FontSize="11"/>
                            </Grid>
                            <Separator Background="{DynamicResource LineSoftBrush}"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1" Text="温度采集模块"/>
                                <TextBlock Grid.Column="2" Text="已连接" Foreground="{DynamicResource GoodBrush}" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
