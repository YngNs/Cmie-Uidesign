<UserControl x:Class="Cmie.MotorTest.Wpf.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Style="{StaticResource PageRootStyle}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                <Run Text="{Binding Crumb, ElementName=Root}"/>
                <Run Text=" / "/>
                <Run Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource HeadingTextStyle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource PanelStyle}"
                Padding="28"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="页面占位"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding Description, ElementName=Root}"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           LineHeight="22"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
