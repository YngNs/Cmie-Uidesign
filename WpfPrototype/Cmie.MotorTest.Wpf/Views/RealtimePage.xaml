<UserControl x:Class="Cmie.MotorTest.Wpf.Views.RealtimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:project="clr-namespace:Cmie.MotorTest.Wpf.Views.Project"
             Style="{StaticResource PageRootStyle}">
    <UserControl.Resources>
        <DataTemplate x:Key="RealtimeMetricTemplate">
            <Border Margin="0,0,8,8" Padding="12,10" MinWidth="190"
                    Background="{DynamicResource MetricBrush}" BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding Unit}" Margin="5,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Ellipse Grid.Column="1" Width="6" Height="6" Margin="12,0,4,0"
                             VerticalAlignment="Center" Fill="{DynamicResource GoodBrush}"/>
                    <Button Grid.Column="2" Tag="{Binding}" Content="☆" FontSize="15" Padding="2"
                            ToolTip="设为 / 取消重点" Click="Pin_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopButtonStyle}">
                                <Setter Property="Content" Value="☆"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="★"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="RealtimeGroupStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Text="工作区 / 实时数据"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="实时数据" Style="{StaticResource HeadingTextStyle}" FontSize="24"/>
                    <Border Margin="10,4,0,4" Padding="9,0" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="1 kHz 采样" FontSize="10" Foreground="{DynamicResource GoodBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SampleTimeText" Margin="0,0,12,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                <Button Content="刷新一次" Style="{StaticResource ActionButtonStyle}" Height="34" Click="Refresh_Click"/>
                <Button x:Name="FreezeButton" Content="冻结" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryActionButtonStyle}" Height="34" Click="Freeze_Click"/>
                <Button Content="清空重点" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                        Height="34" Click="ClearPins_Click"/>
            </StackPanel>
        </Grid>

        <project:PinnedMetricsBar x:Name="PinnedBar" Grid.Row="1"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource RealtimeGroupStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="测量数据" Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MeasurementMetrics}" ItemTemplate="{StaticResource RealtimeMetricTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource RealtimeGroupStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="轴功率" Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding ShaftMetrics}" ItemTemplate="{StaticResource RealtimeMetricTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource RealtimeGroupStyle}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="温度 · 被试设备" Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TemperatureMetrics}" ItemTemplate="{StaticResource RealtimeMetricTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
