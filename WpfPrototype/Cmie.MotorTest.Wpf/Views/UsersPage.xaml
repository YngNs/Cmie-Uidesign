<UserControl x:Class="Cmie.MotorTest.Wpf.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRootStyle}" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="ModernUserItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemCard" Padding="14,11" CornerRadius="10"
                                Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource MetricBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0">
                            <TextBlock Text="♙" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="用户与权限" Style="{StaticResource HeadingTextStyle}" FontSize="23"/>
                            <TextBlock Text="管理本机账户、访问角色和试验数据权限" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="15,0" Click="Refresh_Click"/>
                    <Button Content="编辑账户" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="15,0" Click="Edit_Click"/>
                    <Button Content="删除" Margin="8,0,0,0" Foreground="{DynamicResource BadBrush}" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="15,0" Click="Delete_Click"/>
                    <Button Content="＋  新建账户" Margin="8,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}" Height="36" Padding="17,0" Click="New_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="全部账户" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="AccountCountText" Text="0" Margin="0,5,0,0" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"><TextBlock Text="◎" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="已启用" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="EnabledCountText" Text="0" Margin="0,5,0,0" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#1422A35A" VerticalAlignment="Center"><TextBlock Text="✓" Foreground="{DynamicResource GoodBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="管理员" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="AdminCountText" Text="0" Margin="0,5,0,0" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#14F59E0B" VerticalAlignment="Center"><TextBlock Text="◇" Foreground="#FFF59E0B" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="17,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,9,0"/>
                            <StackPanel><TextBlock Text="本机账户" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="账户信息仅保存在当前工作站" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,5" CornerRadius="9" Background="{DynamicResource MetricBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentUserText" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Background="{DynamicResource MetricBrush}" Margin="10,0" Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="155"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="账户" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="显示名称" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="登录密码" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="角色" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="状态" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="最近登录" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="备注" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="UsersGrid" ItemsSource="{Binding Users}" SelectionMode="Single"
                             BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ModernUserItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="155"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="11.5"/>
                                        <TextBlock Text="{Binding AccountMeta}" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5"/>
                                        <TextBlock Text="系统保护账户" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Visibility="Collapsed" x:Name="ProtectedText"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Padding="9,4" CornerRadius="8" Background="{DynamicResource MetricBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PasswordDisplay}" MinWidth="62" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            <Button Content="{Binding PasswordButtonText}" Margin="6,0,0,0" Padding="5,1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" FontSize="9.5" Click="TogglePassword_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="RoleBadge" Grid.Column="4" Padding="9,4" CornerRadius="8" Background="{DynamicResource MetricBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock x:Name="RoleText" Text="{Binding RoleDisplay}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="StatusBadge" Grid.Column="5" Padding="8,4" CornerRadius="9" Background="#1422A35A" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource GoodBrush}" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="{Binding StatusDisplay}" Foreground="{DynamicResource GoodBrush}" FontSize="10" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="6" Text="{Binding LastLoginDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="7" Text="{Binding Note}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RoleDisplay}" Value="管理员"><Setter TargetName="RoleBadge" Property="Background" Value="#14F59E0B"/><Setter TargetName="RoleText" Property="Foreground" Value="#FFF59E0B"/></DataTrigger>
                                    <DataTrigger Binding="{Binding RoleDisplay}" Value="试验员"><Setter TargetName="RoleBadge" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="RoleText" Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="StatusBadge" Property="Background" Value="#14DC2626"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource BadBrush}"/><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True"><Setter TargetName="ProtectedText" Property="Visibility" Value="Visible"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="EditorOverlay" Visibility="Collapsed" Background="#720F172A" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" Panel.ZIndex="50">
            <Border Width="500" Padding="24" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Editor_MouseLeftButtonDown">
                <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Color="#33000000"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0"><TextBlock Text="♙" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock x:Name="EditorTitle" Text="新建用户" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="配置账户身份和数据访问权限" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="用户名" Margin="0,19,0,5" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="NameInput" Height="40" Style="{StaticResource FormTextBoxStyle}" Background="{DynamicResource MetricBrush}" Padding="11,0"/>
                    <TextBlock Text="显示名称" Margin="0,12,0,5" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="DisplayNameInput" Height="40" Style="{StaticResource FormTextBoxStyle}" Background="{DynamicResource MetricBrush}" Padding="11,0"/>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="密码" Margin="0,0,0,5" Foreground="{DynamicResource MutedBrush}"/><PasswordBox x:Name="PasswordInput" Height="40" Background="{DynamicResource MetricBrush}" Padding="11,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="确认密码" Margin="0,0,0,5" Foreground="{DynamicResource MutedBrush}"/><PasswordBox x:Name="ConfirmPasswordInput" Height="40" Background="{DynamicResource MetricBrush}" Padding="11,0"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="PasswordHint" Text="密码不限制复杂度，只需非空。" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="角色" Margin="0,0,0,5" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="RoleInput" Height="40" SelectedIndex="1"><ComboBoxItem Content="管理员"/><ComboBoxItem Content="试验员"/><ComboBoxItem Content="只读用户"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="状态" Margin="0,0,0,5" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="StatusInput" Height="40" SelectedIndex="0"><ComboBoxItem Content="启用"/><ComboBoxItem Content="停用"/></ComboBox></StackPanel>
                    </Grid>
                    <TextBlock Text="说明" Margin="0,12,0,5" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="NoteInput" Height="40" Style="{StaticResource FormTextBoxStyle}" Background="{DynamicResource MetricBrush}" Padding="11,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="取消" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="18,0" Click="CancelEditor_Click"/>
                        <Button Content="保存账户" Margin="8,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}" Height="36" Padding="19,0" Click="SaveEditor_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
