<UserControl x:Class="Cmie.MotorTest.Wpf.Views.Project.TestFloatingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" MinHeight="420"
             PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown">
    <UserControl.Resources>
        <DropShadowEffect x:Key="FloatingWindowShadow" BlurRadius="20" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.18"/>
        <Style x:Key="ResistanceSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style x:Key="ResistanceCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        </Style>
        <Style x:Key="ResistanceHeaderCellStyle" TargetType="Border" BasedOn="{StaticResource ResistanceCellStyle}">
            <Setter Property="Background" Value="{DynamicResource MetricBrush}"/>
        </Style>
        <Style x:Key="ResistanceCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ResistanceHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ResistanceCellTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="ResistanceInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style x:Key="ResistanceToolStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="35"/><Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="WindowChrome" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="10" Effect="{StaticResource FloatingWindowShadow}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border x:Name="TitleBar" Background="{DynamicResource MetricBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="—" ToolTip="最小化" Style="{StaticResource TopButtonStyle}" Padding="7,3" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Grid.Column="2" Content="□" ToolTip="最大化" Style="{StaticResource TopButtonStyle}" Padding="7,3" Click="Maximize_Click"/>
                    <Button Grid.Column="3" Content="×" ToolTip="关闭" Style="{StaticResource TopButtonStyle}" Padding="7,3" Foreground="{DynamicResource BadBrush}" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>

                <Grid Margin="16,12,14,14">
                    <!-- 电阻测量专用工作表 -->
                    <ScrollViewer x:Name="ResistancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="直流电阻与绝缘电阻测量" Style="{StaticResource HeadingTextStyle}" FontSize="17"/><TextBlock x:Name="ResistanceProjectText" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/></StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="9,4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="0,0,6,0"/><TextBlock Text="测量就绪" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
                            </Grid>

                            <!-- 铭牌参数 -->
                            <Border Style="{StaticResource ResistanceSectionStyle}" Padding="12" Margin="0,0,0,12">
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="4"><TextBlock Text="型号 Type" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="Y2-160M-4" Margin="0,3,0,0" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="编号 ID" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="2025DJXXXX" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="电压 Voltage" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="380 V" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="电流 Current" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="15.0 A" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="功率 Power" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="11 kW" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="转速 Speed" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="1460 rpm" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="频率 Freq" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="50 Hz" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="功率因数 PF" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="0.86" Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="接线 Wire" Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="Y" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="绝缘 Ins." Foreground="{DynamicResource MutedBrush}" FontSize="9.5"/><TextBlock Text="F" Margin="0,3,0,0"/></StackPanel>
                                </UniformGrid>
                            </Border>

                            <!-- 绝缘电阻 -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6"><Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="电机绝缘电阻测量" FontWeight="SemiBold"/><TextBlock Text="  Measurement of insulation resistance (MΩ)" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                            <Border Style="{StaticResource ResistanceSectionStyle}" Margin="0,0,0,12" ClipToBounds="True">
                                <Grid Height="90">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="状态 / Item" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Column="1" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="定子绕组" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="2" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="转子绕组" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="轴承" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="4" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="加热器" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="5" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="环境温度 ℃" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="6" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="湿度 %" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="1" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="冷态 Cold" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="热态 Hot" Style="{StaticResource ResistanceCellTextStyle}"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="120" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="200" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="25.0" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="48" Style="{StaticResource ResistanceInputStyle}"/></Border>
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBox Style="{StaticResource ResistanceInputStyle}"/></Border>
                                </Grid>
                            </Border>

                            <!-- 冷态直流电阻 -->
                            <Grid Margin="2,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="冷态直流电阻" FontWeight="SemiBold"/><TextBlock Text="  DC resistance at cold state (Ω)" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel><TextBlock Text="定子接法 Str.Wire：Y    ·    转子接法 Rtr.Wire：—" Margin="11,3,0,0" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource MetricBrush}" CornerRadius="8" Padding="9,3" Margin="0,0,7,0"><TextBlock Text="绕组温度 T1  25.0℃" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></Border><Border Grid.Column="2" Background="{DynamicResource MetricBrush}" CornerRadius="8" Padding="9,3"><TextBlock Text="规定折算温度 Tref  75.0℃" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/></Border></Grid>
                            <Border Style="{StaticResource ResistanceSectionStyle}" Margin="0,0,0,12" ClipToBounds="True">
                                <Grid Height="208">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="项目 Item" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="定子绕组  Stator Winding" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="转子绕组  Rotor Winding" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="1" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="线电阻 Line Res." Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R U-V" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R V-W" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R W-U" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R K-L" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="1" Grid.Column="5" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R L-M" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="1" Grid.Column="6" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="R M-K" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="测量值 Measure" Style="{StaticResource ResistanceCellTextStyle}" FontWeight="SemiBold"/></Border><Border Grid.Row="3" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="规定温度折算值" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="相电阻 Phase Res." Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="5" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="规定温度折算值" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="6" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="不平衡度 Unbalance %" Style="{StaticResource ResistanceCellTextStyle}"/></Border>
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRabBox" Text="0.842" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRbcBox" Text="0.839" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRcaBox" Text="0.845" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRabBox" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRbcBox" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="2" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRcaBox" Style="{StaticResource ResistanceInputStyle}"/></Border>
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="StatorRabRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="StatorRbcRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="3" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="StatorRcaRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="3" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="RotorRabRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="3" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="RotorRbcRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="3" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="RotorRcaRefText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R U" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R V" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R W" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R K" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R L" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="4" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="R M" Style="{StaticResource ResistanceCellTextStyle}"/></Border>
                                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRaRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="5" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRbRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="5" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="StatorRcRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="5" Grid.Column="4" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRaRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="5" Grid.Column="5" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRbRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="5" Grid.Column="6" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorRcRefBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border>
                                    <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ResistanceCellStyle}"><TextBlock x:Name="StatorUnbalanceText" Text="—" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource ResistanceCellStyle}"><TextBox x:Name="RotorUnbalanceBox" IsReadOnly="True" Style="{StaticResource ResistanceInputStyle}"/></Border>
                                </Grid>
                            </Border>

                            <!-- 测温电阻 -->
                            <StackPanel Margin="2,0,0,6"><StackPanel Orientation="Horizontal"><Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="电阻检温计的冷态直流电阻和绝缘电阻测量" FontWeight="SemiBold"/></StackPanel><TextBlock Text="DC resistance and insulation resistance measurement for resistance temperature detectors (ETD)" Margin="11,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel>
                            <Border Style="{StaticResource ResistanceSectionStyle}" ClipToBounds="True">
                                <Grid Height="196">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="序号 NO" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Column="1" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="1#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="2" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="2#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="3#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="4" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="4#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="5" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="5#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="6" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="6#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="7" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="7#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="8" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="8#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Column="9" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="9#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="1" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="直流电阻 DC Res (Ω)" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="绝缘电阻 Ins. Res (MΩ)" Style="{StaticResource ResistanceCellTextStyle}"/></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="109.8" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="110.1" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ResistanceCellStyle}"><TextBox Text="109.6" Style="{StaticResource ResistanceInputStyle}"/></Border><Border Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="6" Style="{StaticResource ResistanceCellStyle}"/>
                                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="9" Style="{StaticResource ResistanceCellStyle}"/>
                                    <Border Grid.Row="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="序号 NO" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="10#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="11#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="3" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="12#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="4" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="13#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="5" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="14#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="6" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="15#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="7" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="16#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="8" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="17#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border><Border Grid.Row="3" Grid.Column="9" Style="{StaticResource ResistanceHeaderCellStyle}"><TextBlock Text="18#" Style="{StaticResource ResistanceHeaderTextStyle}"/></Border>
                                    <Border Grid.Row="4" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="直流电阻 DC Res (Ω)" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="5" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="绝缘电阻 Ins. Res (MΩ)" Style="{StaticResource ResistanceCellTextStyle}"/></Border>
                                    <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="9" Style="{StaticResource ResistanceCellStyle}"/><Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="9" Style="{StaticResource ResistanceCellStyle}"/>
                                    <Border Grid.Row="6" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="环境温度 Ambient T" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="25.0 ℃" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource AccentBrush}"/></Border><Border Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="兆欧表 Megger" Style="{StaticResource ResistanceCellTextStyle}"/></Border><Border Grid.Row="6" Grid.Column="7" Grid.ColumnSpan="3" Style="{StaticResource ResistanceCellStyle}"><TextBlock Text="ZC25-3 · 500 V" Style="{StaticResource ResistanceCellTextStyle}" Foreground="{DynamicResource MutedBrush}"/></Border>
                                    <!-- 保留 1#–18# 每个通道的独立列线，空值也不合并视觉单元格 -->
                                    <Border Grid.Column="1" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="2" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="3" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="4" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="5" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="6" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="7" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/><Border Grid.Column="8" Grid.RowSpan="6" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineSoftBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空载、负载、A 法分析使用代码生成的完整专用矩阵 -->
                    <ScrollViewer x:Name="GeneratedPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="GeneratedContent" MinWidth="900"/>
                    </ScrollViewer>

                    <!-- 其他试验继续使用通用占位模板 -->
                    <Grid x:Name="GenericPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,3"><TextBlock Text="RUNNING" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/></Border><StackPanel><TextBlock x:Name="BodyTitleText" Style="{StaticResource HeadingTextStyle}" FontSize="18"/><TextBlock x:Name="ProjectText" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></DockPanel>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource LineBrush}" Margin="0,12"/>
                        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="4" Background="{DynamicResource MetricBrush}" CornerRadius="5,5,0,0"/><TextBlock Text="测量点" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="A 相" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="2" Text="B 相" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="3" Text="C 相" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Grid.Row="1" Text="电压 / V" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="380.2" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="379.8" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="380.1" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Row="2" Text="电流 / A" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="12.41" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="12.48" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="12.46" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Row="3" Text="输入功率 / W" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="7820.0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <Border Grid.Row="4" Grid.ColumnSpan="4" Margin="0,10,0,0" Padding="12" Background="{DynamicResource MetricBrush}" CornerRadius="6"><TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource MetricBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <StackPanel x:Name="ResistanceTools" Visibility="Collapsed" Margin="9,12">
                            <TextBlock Text="测量操作" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                            <Button Content="▧  表格清空" Tag="表格清空" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="↧  冷态温度" Tag="冷态温度" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="▣  数据调用" Tag="数据调用" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="●  数据保存" Tag="数据保存" Style="{StaticResource ResistanceToolStyle}" Foreground="{DynamicResource AccentBrush}" Click="Tool_Click"/>
                            <Button Content="∑  阻值计算" Tag="阻值计算" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="⇩  导出记录" Tag="导出记录" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="▤  预览打印" Tag="预览打印" Style="{StaticResource ResistanceToolStyle}" Click="Tool_Click"/>
                            <Button Content="×  退出操作" Style="{StaticResource ResistanceToolStyle}" Foreground="{DynamicResource BadBrush}" Margin="0,8,0,0" Click="Close_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="GenericTools" Margin="9,12">
                            <TextBlock Text="试验操作" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <Button Content="数据调用" Tag="数据调用" Style="{StaticResource ActionButtonStyle}" Height="34" Margin="0,3" Click="Tool_Click"/><Button Content="数据保存" Tag="数据保存" Style="{StaticResource PrimaryActionButtonStyle}" Height="34" Margin="0,3" Click="Tool_Click"/><Button Content="计算" Tag="结果计算" Style="{StaticResource ActionButtonStyle}" Height="34" Margin="0,3" Click="Tool_Click"/><Button Content="导出" Tag="导出记录" Style="{StaticResource ActionButtonStyle}" Height="34" Margin="0,3" Click="Tool_Click"/><Button Content="退出" Style="{StaticResource ActionButtonStyle}" Height="34" Margin="0,14,0,3" Foreground="{DynamicResource BadBrush}" Click="Close_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="GeneratedTools" Visibility="Collapsed" Margin="9,12"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ResizeHandles" Grid.RowSpan="2">
                <Border Tag="T" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="B" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="L" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="R" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="TL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="TR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="BL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
                <Border Tag="BR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
