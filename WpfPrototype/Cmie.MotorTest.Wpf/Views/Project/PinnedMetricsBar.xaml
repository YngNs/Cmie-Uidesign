<UserControl x:Class="Cmie.MotorTest.Wpf.Views.Project.PinnedMetricsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PinnedIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" Visibility="Collapsed" Height="54" Padding="10,7"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="10" VerticalAlignment="Top"
            SizeChanged="Root_SizeChanged">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="2,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="重点指标" Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeaderCountText" Text="0 项" Margin="0,3,0,0"
                           Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
            <ScrollViewer x:Name="MetricsViewport" Grid.Column="2" Margin="10,0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
            <ItemsControl x:Name="ItemsHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,6,0" Padding="0" Width="190" Height="38"
                                Background="{DynamicResource MetricBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="7"
                                Tag="{Binding}" Cursor="Arrow" AllowDrop="True"
                                ToolTip="按住拖动调整顺序"
                                PreviewMouseLeftButtonDown="MetricCard_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="MetricCard_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="MetricCard_PreviewMouseMove"
                                GiveFeedback="MetricCard_GiveFeedback"
                                DragEnter="MetricCard_DragEnter"
                                DragOver="MetricCard_DragOver"
                                DragLeave="MetricCard_DragLeave"
                                Drop="MetricCard_Drop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="7,0,0,7"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Unit}" Margin="3,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Button Content="★" Tag="{Binding}" ToolTip="取消重点"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Style="{StaticResource PinnedIconButtonStyle}" Click="Remove_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <Button x:Name="MoreButton" Grid.Column="3" Content="+0" Padding="8,3" Margin="0,0,4,0"
                    MinWidth="36" FontSize="10" Visibility="Hidden" ToolTip="查看全部重点指标"
                    VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                    Style="{StaticResource TopButtonStyle}" Click="More_Click"/>
            <Button Grid.Column="4" Content="清空" Padding="7,3" FontSize="10"
                    VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                    Style="{StaticResource TopButtonStyle}" Click="Clear_Click"/>

            <Popup x:Name="OverflowPopup" Grid.Column="3" Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MoreButton}" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="292" MaxHeight="390" Margin="0,7,0,0" Padding="10"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,8">
                            <TextBlock x:Name="PopupCountText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                            <TextBlock Text="未显示的重点指标" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PopupItemsHost">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="OverflowCard" Height="38" Margin="0,0,0,5" Padding="0"
                                                Background="{DynamicResource MetricBrush}"
                                                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
                                                CornerRadius="7" Tag="{Binding}" Cursor="Arrow" AllowDrop="True"
                                                ToolTip="按住拖动调整顺序"
                                                PreviewMouseLeftButtonDown="MetricCard_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="MetricCard_PreviewMouseLeftButtonUp"
                                                PreviewMouseMove="MetricCard_PreviewMouseMove"
                                                GiveFeedback="MetricCard_GiveFeedback"
                                                DragEnter="MetricCard_DragEnter"
                                                DragOver="MetricCard_DragOver"
                                                DragLeave="MetricCard_DragLeave"
                                                Drop="MetricCard_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="7,0,0,7"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="9,0,6,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Unit}" Margin="3,0,0,0"
                                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="★" Tag="{Binding}" ToolTip="取消重点"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Style="{StaticResource PinnedIconButtonStyle}" Click="Remove_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
