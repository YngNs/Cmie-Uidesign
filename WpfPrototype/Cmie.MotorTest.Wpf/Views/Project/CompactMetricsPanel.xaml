<UserControl x:Class="Cmie.MotorTest.Wpf.Views.Project.CompactMetricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="MetricRowTemplate">
            <Grid Height="34" Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Padding="2" ToolTip="设为 / 取消重点"
                        Style="{StaticResource TopButtonStyle}" Click="Pin_Click">
                    <TextBlock Text="☆" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Text" Value="★"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="5,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                <Border Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineSoftBrush}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="MetricExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="实时数据" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="‹" ToolTip="收起实时数据" Style="{StaticResource TopButtonStyle}"
                        Padding="7,3" Click="Collapse_Click"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="7,0,7,8">
                    <Expander Header="测量数据" Style="{StaticResource MetricExpanderStyle}">
                        <ItemsControl ItemsSource="{Binding MeasurementMetrics}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </Expander>
                    <Expander Header="轴功率" Style="{StaticResource MetricExpanderStyle}">
                        <ItemsControl ItemsSource="{Binding ShaftMetrics}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </Expander>
                    <Expander Header="温度 · 被试设备" Style="{StaticResource MetricExpanderStyle}">
                        <ItemsControl ItemsSource="{Binding TemperatureMetrics}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
