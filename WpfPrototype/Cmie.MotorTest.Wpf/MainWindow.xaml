<Window x:Class="Cmie.MotorTest.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:Cmie.MotorTest.Wpf.Dialogs"
        Title="三相异步电机测试软件"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 品牌栏：点击回首页 -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="#12000000"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="Brand_Click">
                <Grid x:Name="BrandRoot" Margin="16,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Stroke="#4700D4FF" StrokeThickness="1.5"/>
                        <Path Data="M17,4 C25,4 31,11 31,17"
                              Stroke="{DynamicResource AccentBrightBrush}"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <Path Data="M31,17 C31,25 25,31 17,31 C9,31 3,25 3,17 C3,9 9,4 17,4"
                              Stroke="#7A00D4FF"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <Ellipse Width="9" Height="9"
                                 Fill="{DynamicResource AccentBrightBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <Ellipse Width="4" Height="4"
                                 Fill="{DynamicResource SidebarBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="BrandTextPanel"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="CMIE"
                                   Foreground="#EEF2F5"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="中机国际"
                                   Foreground="#C4CED4"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 顶栏 -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Button x:Name="OpMenuButton"
                                    Style="{StaticResource TopButtonStyle}"
                                    Content="⚙  试验操作  ▾"
                                    Click="OpMenuButton_Click"/>
                            <Popup x:Name="OpMenuPopup"
                                   PlacementTarget="{Binding ElementName=OpMenuButton}"
                                   Placement="Bottom"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Closed="MenuPopup_Closed">
                                <Border Style="{StaticResource DropdownPanelStyle}">
                                    <StackPanel>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="新建试验" Tag="新建试验" Click="TopMenuItem_Click"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="上次试验" Tag="上次试验" Click="TopMenuItem_Click"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="指定试验" Tag="指定试验" Click="TopMenuItem_Click"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="修改项目参数" Tag="修改项目参数" Click="TopMenuItem_Click"/>
                                        <Border Style="{StaticResource DropdownSepStyle}"/>
                                        <Button Style="{StaticResource DropdownDangerItemStyle}"
                                                Content="退出当前试验项目"
                                                Tag="退出当前试验项目"
                                                Click="TopMenuItem_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Grid>
                            <Button x:Name="HelpMenuButton"
                                    Style="{StaticResource TopButtonStyle}"
                                    Content="?  帮助  ▾"
                                    Click="HelpMenuButton_Click"/>
                            <Popup x:Name="HelpMenuPopup"
                                   PlacementTarget="{Binding ElementName=HelpMenuButton}"
                                   Placement="Bottom"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Closed="MenuPopup_Closed">
                                <Border Style="{StaticResource DropdownPanelStyle}">
                                    <StackPanel>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="使用说明" Tag="使用说明" Click="TopMenuItem_Click"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="关于软件" Tag="关于软件" Click="TopMenuItem_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Padding="10,5"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="12"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="系统正常" Foreground="{DynamicResource GoodBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Button x:Name="UserMenuButton"
                                    Style="{StaticResource TopButtonStyle}"
                                    Click="UserMenuButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Background="{DynamicResource AccentBrush}" CornerRadius="13">
                                        <TextBlock x:Name="UserAvatarText"
                                                   Text="超"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"/>
                                    </Border>
                                    <TextBlock x:Name="UserNameText"
                                               Text="超级用户  ▾"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Popup x:Name="UserMenuPopup"
                                   PlacementTarget="{Binding ElementName=UserMenuButton}"
                                   Placement="Bottom"
                                   HorizontalAlignment="Right"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Closed="MenuPopup_Closed">
                                <Border Style="{StaticResource DropdownPanelStyle}" MinWidth="200">
                                    <StackPanel>
                                        <TextBlock x:Name="UserAccountHeader"
                                                   Style="{StaticResource DropdownHeaderStyle}"
                                                   Text="当前账户 · 超级用户"/>
                                        <Border Style="{StaticResource DropdownSepStyle}"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="用户登录" Tag="用户登录" Click="UserMenuItem_Click"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="用户注销" Tag="用户注销" Click="UserMenuItem_Click"/>
                                        <Border Style="{StaticResource DropdownSepStyle}"/>
                                        <Button Style="{StaticResource DropdownItemStyle}" Content="用户管理" Tag="用户管理" Click="UserMenuItem_Click"/>
                                        <Border Style="{StaticResource DropdownSepStyle}"/>
                                        <Button Style="{StaticResource DropdownDangerItemStyle}"
                                                Content="退出程序"
                                                Tag="退出程序"
                                                Click="UserMenuItem_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="ThemeButton"
                                Style="{StaticResource TopButtonStyle}"
                                Click="ThemeButton_Click"
                                Content="☀"
                                FontSize="16"
                                ToolTip="切换浅色主题"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左导航 -->
            <Border x:Name="SidebarBorder"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="#12000000"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SideNavPanel" Margin="0,14,0,0">
                        <TextBlock x:Name="SideWorkspaceLabel"
                                   Text="工作区"
                                   Foreground="#57FFFFFF"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="22,0,0,8"
                                   MaxHeight="24"
                                   TextOptions.TextFormattingMode="Ideal"/>
                        <Button x:Name="NavHomeButton"
                                Tag="home"
                                Style="{StaticResource SideActiveButtonStyle}"
                                Click="NavButton_Click"
                                ToolTip="首页">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="20" Width="28" TextAlignment="Center"/>
                                <TextBlock x:Name="NavHomeLabel" Text="首页" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavProjectButton"
                                Tag="project"
                                Style="{StaticResource SideButtonStyle}"
                                Click="NavButton_Click"
                                ToolTip="试验项目">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" FontSize="17" Width="28" TextAlignment="Center"/>
                                <TextBlock x:Name="NavProjectLabel" Text="试验项目" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRealtimeButton"
                                Tag="realtime"
                                Style="{StaticResource SideButtonStyle}"
                                Click="NavButton_Click"
                                ToolTip="实时数据">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌁" FontSize="20" Width="28" TextAlignment="Center"/>
                                <TextBlock x:Name="NavRealtimeLabel" Text="实时数据" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator x:Name="SideNavSeparator" Margin="16,9" Background="#14FFFFFF"/>
                        <Button x:Name="NavSettingsButton"
                                Tag="settings"
                                Style="{StaticResource SideButtonStyle}"
                                Click="NavButton_Click"
                                ToolTip="相关设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="16" Width="28" TextAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsLabel" Text="相关设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavReportButton"
                                Tag="report"
                                Style="{StaticResource SideButtonStyle}"
                                Click="NavButton_Click"
                                ToolTip="报表输出">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" FontSize="17" Width="28" TextAlignment="Center"/>
                                <TextBlock x:Name="NavReportLabel" Text="报表输出" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="CollapseMenuButton"
                            Grid.Row="1"
                            Style="{StaticResource SideButtonStyle}"
                            Click="CollapseMenuButton_Click"
                            ToolTip="收起菜单">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CollapseMenuIcon" Text="‹" FontSize="18" Width="28" TextAlignment="Center"/>
                            <TextBlock x:Name="CollapseMenuLabel" Text="收起菜单" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区：页面容器 -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Grid.Column="1"
                            Focusable="False"/>

            <!-- 状态栏 -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource StatusBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="13,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备  Motor Test Bench #1" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="  |  SN: MTB-20240521001" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="  |  固件: v1.3.2" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BackendStatusText" Text="数据存储: 本地" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                        <Ellipse x:Name="BackendStatusDot" Width="6" Height="6" Fill="{DynamicResource WarnBrush}" Margin="8,0"/>
                        <TextBlock Text="采样频率: 1 kHz" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,64"
                Padding="18,11"
                Background="{DynamicResource ToastBrush}"
                CornerRadius="12"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="70">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Color="#38000000"
                                  Opacity="0.55"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- 登录全屏层：纯矢量赛博风，无位图 -->
        <dialogs:LoginOverlay x:Name="LoginOverlay"
                              Visibility="Collapsed"
                              Panel.ZIndex="200"
                              Submitted="LoginOverlay_Submitted"
                              Cancelled="LoginOverlay_Cancelled"
                              ValidationFailed="LoginOverlay_ValidationFailed"/>
    </Grid>
</Window>
