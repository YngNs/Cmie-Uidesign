<Window x:Class="Cmie.MotorTest.Wpf.Dialogs.WorksheetHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="试验历史记录" Width="720" Height="430" MinWidth="620" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PageBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="历史记录" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="每次保存都会生成独立快照；选择一条记录后可以读取或删除。" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
            <DataGrid x:Name="RecordsGrid" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" RowHeight="42" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="记录名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="保存人" Binding="{Binding SavedBy}" Width="*"/>
                    <DataGridTextColumn Header="保存时间" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="双击记录可直接读取" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="删除" Foreground="{DynamicResource BadBrush}" Style="{StaticResource ActionButtonStyle}" Click="Delete_Click"/>
                <Button Content="关闭" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}" Click="Close_Click"/>
                <Button Content="读取记录" Margin="8,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}" Click="Load_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
